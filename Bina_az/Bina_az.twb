    <worksheet name='Top N Average of Price by Floor'>
      <table>
        <view>
          <datasources>
            <datasource caption='bina_az_50_page_raw_cleaning_for_Tableau' name='federated.1tvixx91kzfywf13dua0e11ic7aq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tvixx91kzfywf13dua0e11ic7aq'>
            <column-instance column='[price]' derivation='Avg' name='[avg:price:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Floor' datatype='integer' name='[floor]' role='dimension' type='ordinal' />
            <column-instance column='[floor]' derivation='None' name='[none:floor:ok]' pivot='key' type='ordinal' />
            <column caption='Price' datatype='integer' name='[price]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1tvixx91kzfywf13dua0e11ic7aq].[none:floor:ok]'>
