      <column caption='Color Churn Rate' datatype='string' name='[Calculation_1621577359502929942]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1621577359477211144] &gt; 0 THEN &quot;Red&quot;&#13;&#10;ELSE &quot;Green&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Recency' datatype='integer' name='[Calculation_484136980060291072]' role='measure' type='quantitative'>
