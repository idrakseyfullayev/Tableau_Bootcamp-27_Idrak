          <datasource-dependencies datasource='federated.0563y891e4c8rf1f306it1wol3po'>
            <column caption='Active Customers' datatype='integer' name='[Calculation_1621577359476350981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([CustomerID])' />
            </column>
            <column caption='Active Customers Previous Month' datatype='integer' name='[Calculation_1621577359476699142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(COUNTD([CustomerID]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Lost Customers' datatype='integer' name='[Calculation_1621577359477125127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1621577359476699142] - [Calculation_1621577359476350981]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Churn Rate' datatype='real' name='[Calculation_1621577359477211144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1621577359477125127] / [Calculation_1621577359476699142]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Negative Churn Rate' datatype='real' name='[Calculation_1621577359488729100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Calculation_1621577359477211144]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Color Churn Rate' datatype='string' name='[Calculation_1621577359502929942]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1621577359477211144] &gt; 0 THEN &quot;Red&quot;&#13;&#10;ELSE &quot;Green&quot;&#13;&#10;END'>
