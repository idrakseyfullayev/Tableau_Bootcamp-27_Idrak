      <column caption='Birth Date' datatype='date' name='[Birth_Date]' role='dimension' type='ordinal' />
      <column caption='Number of Survey' datatype='integer' name='[Calculation_1163899096964747264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([SURVEY_Participant_ID])' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_1163899096984961025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birth_Date], TODAY())' />
      </column>
      <column caption='Isnull' datatype='boolean' name='[Calculation_1163899096997916674]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([RATING])' />
      </column>
      <column caption='Rating with Words' datatype='string' name='[Calculation_1163899097022558211]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [RATING]&#13;&#10;    WHEN 1 THEN &apos;Very Dissatisfied&apos;&#13;&#10;    WHEN 2 THEN &apos;Dissatisfied&apos;&#13;&#10;    WHEN 3 THEN &apos;Neutral&apos;&#13;&#10;    WHEN 4 THEN &apos;Satisfied&apos;&#13;&#10;    WHEN 5 THEN &apos;Very Satisfied&apos;&#13;&#10;END' />
      </column>
      <column caption='Happy or Sad' datatype='string' name='[Calculation_1163899097025142788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [RATING] &gt; 3 &#13;&#10;    THEN &apos;Happy&apos;&#13;&#10;ELSE&#13;&#10;    &apos;Sad&apos; &#13;&#10;END' />
      </column>
