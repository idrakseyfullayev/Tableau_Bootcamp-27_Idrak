      <aliases enabled='yes' />
      <column caption='Total Churn' datatype='real' name='[Calculation_422212531231129600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Churn_May] + [Churn_June] + [Churn_July]' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_422212531233001473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_422212531231129600]) / COUNT([__tableau_internal_object_id__].[Gross_adds (1).sav_A440941B632A4047B799C73C286F5B04])' />
      </column>
      <column caption='Churn Rate May' datatype='real' name='[Calculation_422212531241525250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Churn_May]) / COUNT([__tableau_internal_object_id__].[Gross_adds (1).sav_A440941B632A4047B799C73C286F5B04])' />
      </column>
      <column caption='Churn Rate June' datatype='real' name='[Calculation_422212531244130307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Churn_June]) / SUM(IF [Churn_May] = 0 THEN 1 END)' />
      </column>
      <column caption='Churn Rate Jule' datatype='real' default-format='p0.0%' name='[Calculation_422212531252162564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Churn_July]) / SUM(IF [Churn_May] = 0 &#13;&#10;                       AND [Churn_June] = 0 THEN 1 END)' />
      </column>
